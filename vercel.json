{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/hub/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hub",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "providetech-hub.vercel.app"
        }
      ],
      "destination": "/hub/",
      "permanent": false
    },
    {
      "source": "/:path((?!hub(?:/|$)|assets/).+)",
      "has": [
        {
          "type": "host",
          "value": "providetech-hub.vercel.app"
        }
      ],
      "destination": "https://providetechai.live/:path",
      "permanent": false
    },
    {
      "source": "/hub",
      "missing": [
        {
          "type": "host",
          "value": "providetech-hub.vercel.app"
        }
      ],
      "destination": "https://providetech-hub.vercel.app/hub/",
      "permanent": false
    },
    {
      "source": "/hub/",
      "missing": [
        {
          "type": "host",
          "value": "providetech-hub.vercel.app"
        }
      ],
      "destination": "https://providetech-hub.vercel.app/hub/",
      "permanent": false
    },
    {
      "source": "/hub/:path*",
      "missing": [
        {
          "type": "host",
          "value": "providetech-hub.vercel.app"
        }
      ],
      "destination": "https://providetech-hub.vercel.app/hub/:path*",
      "permanent": false
    }
  ]
}
